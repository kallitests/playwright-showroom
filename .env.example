# =============================================================================
# .env.example — copy to .env and adjust. NEVER commit .env.
# Every variable is optional: without any of them the suite runs against
# https://www.saucedemo.com with no external integration.
# =============================================================================

# ---- Target ------------------------------------------------------------------
# BASE_URL=https://www.saucedemo.com
# Run against a local build of the official SauceDemo sources
# (first: npm run saucedemo:setup)
# LOCAL_SAUCEDEMO=1
# LOCAL_SAUCEDEMO_PORT=4173

# Public demo password shown on the SauceDemo login page (not a secret)
# SAUCE_PASSWORD=secret_sauce

# ---- Toolshop (second application) -----------------------------------------
# TOOLSHOP_ENV=prod            # prod | with-bugs (same app with injected defects)
# TOOLSHOP_UI_URL=             # override, e.g. http://localhost:4200 (local docker setup)
# TOOLSHOP_API_URL=            # override, e.g. http://localhost:8091

# ---- Alerting (scripts/notify/notify.mjs) -------------------------------------
# NOTIFY_ON=failure            # failure | always
# SLACK_WEBHOOK_URL=           # Slack incoming webhook
# TEAMS_WEBHOOK_URL=           # Teams Workflows / incoming webhook URL
# Email is sent by the GitHub workflow (secrets SMTP_SERVER, SMTP_PORT,
# SMTP_USERNAME, SMTP_PASSWORD, NOTIFY_EMAIL_TO) — not from local runs.

# ---- Azure DevOps Test Plans (optional reporter) -------------------------------
# Requires: npm i -D @alex_neo/playwright-azure-reporter
# AZURE_DEVOPS_ORG_URL=https://dev.azure.com/<org>
# AZURE_DEVOPS_PROJECT=<project>
# AZURE_DEVOPS_PLAN_ID=<numeric plan id>
# AZURE_DEVOPS_TOKEN=          # PAT with Test Management read & write
# TEST_ENVIRONMENT=saucedemo
