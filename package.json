{
  "name": "playwright-showroom",
  "version": "2.0.0",
  "description": "Risk-based QA showroom — SauceDemo (UI) + Toolshop (UI + real REST API): Playwright CLI, Playwright MCP exploration, CI/CD and reporting",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:api": "playwright test tests/api --project=chromium",
    "test:regression": "playwright test tests/regression --project=chromium",
    "test:exploratory": "playwright test tests/exploratory --project=chromium",
    "test:critical": "playwright test --project=chromium --grep @critical",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --grep-invert @chromium-only",
    "test:mobile": "playwright test --project=mobile-chrome --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui-mode": "playwright test --ui",
    "test:local": "cross-env-shell LOCAL_SAUCEDEMO=1 playwright test --project=chromium",
    "toolshop": "playwright test -c playwright.toolshop.config.ts --project=api --project=chromium",
    "toolshop:api": "playwright test -c playwright.toolshop.config.ts --project=api",
    "toolshop:ui": "playwright test -c playwright.toolshop.config.ts --project=chromium",
    "toolshop:smoke": "playwright test -c playwright.toolshop.config.ts --project=api --project=chromium --grep @smoke",
    "toolshop:cross-browser": "playwright test -c playwright.toolshop.config.ts --project=chromium --project=firefox --project=webkit",
    "toolshop:with-bugs": "cross-env TOOLSHOP_ENV=with-bugs playwright test -c playwright.toolshop.config.ts --project=api --project=chromium",
    "toolshop:report": "playwright show-report playwright-report-toolshop",
    "toolshop:catalog": "python3 toolshop/catalog/build.py",
    "report": "playwright show-report",
    "report:metrics": "node scripts/metrics/print-summary.mjs",
    "notify": "node scripts/notify/notify.mjs",
    "saucedemo:setup": "node scripts/local-saucedemo/setup.mjs",
    "saucedemo:serve": "node scripts/local-saucedemo/serve.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^20.19.43",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^3.25.76"
  }
}
